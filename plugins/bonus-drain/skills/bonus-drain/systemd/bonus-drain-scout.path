[Unit]
Description=Run a Bonus Drain scout tick when a job frees its slot
Documentation=file://%h/.local/lib/bonus-drain/current/README.md

[Path]
PathChanged=%h/.local/state/bonus-drain/slot-freed
Unit=bonus-drain-scout.service
TriggerLimitIntervalSec=10min
TriggerLimitBurst=60

[Install]
WantedBy=paths.target
