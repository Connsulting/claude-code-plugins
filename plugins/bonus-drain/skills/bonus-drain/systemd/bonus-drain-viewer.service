[Unit]
Description=Loopback Bonus Drain jobs viewer
Documentation=file://%h/.local/lib/bonus-drain/current/SECURITY.md
Wants=bonus-drain-refresh.timer
After=network.target bonus-drain-refresh.timer

[Service]
Type=simple
Environment=BONUS_DRAIN_CONFIG=%h/.config/bonus-drain/config.json
Environment=BONUS_SKILL_DIR=%h/.local/lib/bonus-drain/current
ExecStart=/usr/bin/python3 -B %h/.local/lib/bonus-drain/current/services/jobs-viewer/server.py --port 8766
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
