[Unit]
Description=Loopback Bonus Drain original jobs viewer
Documentation=file://%h/.local/lib/bonus-drain/current/SECURITY.md
After=network.target

[Service]
Type=simple
Environment=BONUS_DRAIN_CONFIG=%h/.config/bonus-drain/config.json
Environment=BONUS_DB=%h/.local/state/bonus-drain/queue.db
Environment=BONUS_SKILL_DIR=%h/.local/lib/bonus-drain/current
ExecStart=/usr/bin/python3 -B %h/.local/lib/bonus-drain/current/services/jobs-viewer/server.py --host 127.0.0.1 --port 8766
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
