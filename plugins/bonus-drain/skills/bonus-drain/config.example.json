{
  "schema_version": 1,
  "recurrence_timezone": "America/New_York",
  "record_command": [
    "/ABSOLUTE/PATH/TO/.local/bin/bonus-drain",
    "record"
  ],
  "usage_max_age_seconds": 3600,
  "scout_ntfy_url": null,
  "host_load_gate": {
    "enabled": true,
    "cpu_some_avg60_max": 40,
    "mem_available_min_gib": 4,
    "load_per_cpu_max": 1.5,
    "disk_free_min_gib": 30
  },
  "secret_refs": [
    {
      "id": "proxy-dotenv",
      "source": "file",
      "path": "/ABSOLUTE/PATH/TO/proxy.env"
    }
  ],
  "adapters": [
    {
      "id": "router",
      "kind": "t3-thread",
      "argv": [
        "/ABSOLUTE/PATH/TO/.local/bin/t3-thread"
      ],
      "timeout_seconds": 90,
      "max_output_bytes": 1048576,
      "env_allowlist": []
    }
  ],
  "providers": [
    {
      "id": "claude",
      "dispatch": {
        "adapter_id": "router",
        "provider": "claude"
      },
      "max_size": "huge",
      "capabilities": [
        "legacy-exclusive",
        "implement"
      ]
    },
    {
      "id": "codex",
      "dispatch": {
        "adapter_id": "router",
        "provider": "codex"
      },
      "max_size": "large",
      "capabilities": [
        "implement"
      ]
    },
    {
      "id": "grok",
      "dispatch": {
        "adapter_id": "router",
        "provider": "grok"
      },
      "max_size": "small"
    },
    {
      "id": "muse",
      "dispatch": {
        "adapter_id": "router",
        "provider": "muse"
      },
      "max_size": "medium"
    }
  ],
  "limits": [
    {
      "id": "claude-weekly",
      "window_seconds": 604800,
      "ceiling_percent": 95,
      "lead_seconds": 604800,
      "batch_size": 3,
      "max_percent_per_window": 0.5,
      "estimated_percent_per_job": 1,
      "pacing_window_seconds": 3600,
      "urgency_seconds": 86400,
      "provider_id": "claude"
    },
    {
      "id": "codex-weekly",
      "window_seconds": 604800,
      "ceiling_percent": 95,
      "lead_seconds": 604800,
      "batch_size": 3,
      "max_percent_per_window": 0.5,
      "estimated_percent_per_job": 1,
      "pacing_window_seconds": 3600,
      "urgency_seconds": 86400,
      "provider_id": "codex"
    }
  ],
  "viewer": {
    "bind": "127.0.0.1",
    "mutations_enabled": true,
    "remote": {
      "trusted_loopback_proxy": true,
      "allowed_hosts": [
        "bonus-drain-node.example.ts.net:8766"
      ],
      "allowed_origins": [
        "https://bonus-drain-node.example.ts.net:8766"
      ]
    }
  },
  "pr_exceptions": [],
  "proxy_secret_ref": "proxy-dotenv",
  "unmetered_max_inflight": 2
}
